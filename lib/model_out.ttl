	<http://www.w3.org/ns/shacl#message> "Only meters can have the isVirtualMeter property be true" ;
	<http://www.w3.org/ns/shacl#prefixes> <http://www.w3.org/2000/01/rdf-schema#> , <https://brickschema.org/schema/Brick#> , <http://www.w3.org/1999/02/22-rdf-syntax-ns#> ;
	<http://www.w3.org/ns/shacl#select> "\n            SELECT $this WHERE {\n                $this brick:isVirtualMeter/brick:value true .\n                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Meter } .\n            }\n        " .
