	<http://www.w3.org/ns/shacl#message> "Only Brick Points can have external timeseries references" ;
	<http://www.w3.org/ns/shacl#prefixes> <https://brickschema.org/schema/Brick/ref#> , <http://www.w3.org/2000/01/rdf-schema#> , <http://www.w3.org/1999/02/22-rdf-syntax-ns#> ;
	<http://www.w3.org/ns/shacl#select> "\n            SELECT $this\n            WHERE {\n                $this ref:hasExternalReference ?ref .\n                ?ref rdf:type ref:TimeseriesReference .\n                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Point }\n            }\n        " .
